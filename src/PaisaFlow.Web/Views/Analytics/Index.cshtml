@model PaisaFlow.Core.DTOs.AnalyticsDto
@{
    ViewData["Title"] = "Analytics & Insights";
}

<div class="ios-header">
    <div>
        <a asp-controller="Dashboard" asp-action="Index" class="section-link" style="font-size: 0.95rem;">‹ Dashboard</a>
        <div class="user-name" style="margin-top: 4px;">Smart Analytics</div>
    </div>
    <div class="header-actions">
        <a asp-controller="Calendar" asp-action="Index" class="icon-btn-glass" title="Calendar">
            <i class="bi bi-calendar-month"></i>
        </a>
    </div>
</div>

<!-- Monthly Spending Total Card -->
<div class="glass-card balance-card">
    <div class="balance-title">
        <span>@Model.MonthName Spending</span>
        <span style="color: var(--accent-blue); font-weight: 600;">Daily Avg: ₹@Model.DailyAverage.ToString("N0")</span>
    </div>

    <div class="balance-amount val-expense">
        ₹@Model.TotalSpending.ToString("N0")
    </div>

    <div style="font-size: 0.88rem; color: var(--text-secondary); margin-top: 4px;">
        Total Income: <span style="color: var(--accent-green); font-weight: 700;">₹@Model.TotalIncome.ToString("N0")</span>
    </div>
</div>

<!-- Actionable Smart Insights Card -->
<div class="section-header">
    <h2 class="section-title">Actionable Insights</h2>
</div>

<div class="glass-card" style="padding: 18px 20px; border-radius: 26px; margin-bottom: 24px; display: flex; flex-direction: column; gap: 14px;">
    @foreach (var insight in Model.SmartInsights)
    {
        <div style="display: flex; align-items: flex-start; gap: 10px; font-size: 0.95rem; font-weight: 500; line-height: 1.4;">
            <div>@insight</div>
        </div>
    }
</div>

<!-- Category Breakdown Table & Bars -->
<div class="section-header">
    <h2 class="section-title">Spending Breakdown</h2>
</div>

<div class="glass-card" style="padding: 18px 20px; border-radius: 26px; margin-bottom: 24px;">
    <div style="display: flex; flex-direction: column; gap: 16px;">
        @foreach (var cat in Model.CategoryBreakdown)
        {
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <span style="font-size: 0.95rem; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                        <span>@cat.Icon</span> @cat.Name
                    </span>
                    <span style="font-size: 0.95rem; font-weight: 700;">
                        ₹@cat.TotalAmount.ToString("N0") <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@cat.PercentageOfTotal%)</span>
                    </span>
                </div>
                <div class="budget-track" style="height: 8px;">
                    <div style="height: 100%; border-radius: var(--pill-radius); background: @cat.Color; width: @cat.PercentageOfTotal%;"></div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Daily Spending Trend (Minimal SVG Sparkline Chart) -->
<div class="section-header">
    <h2 class="section-title">Daily Spending Trend</h2>
</div>

<div class="glass-card" style="padding: 20px; border-radius: 26px; margin-bottom: 30px;">
    @{
        var maxAmount = Model.DailyTrends.Any() ? Math.Max(1000m, Model.DailyTrends.Max(d => d.Amount)) : 1000m;
        var trendCount = Model.DailyTrends.Count;
    }

    <div style="height: 140px; display: flex; align-items: flex-end; gap: 6px; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--glass-border);">
        @foreach (var day in Model.DailyTrends)
        {
            var heightPercent = maxAmount > 0 ? (int)Math.Max(6, Math.Round((day.Amount / maxAmount) * 100)) : 6;
            <div style="flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end;" title="@day.DateStr: ₹@day.Amount.ToString("N0")">
                <div style="width: 100%; max-width: 14px; height: @heightPercent%; background: @(day.Amount > 0 ? "linear-gradient(180deg, #0A84FF, #6366F1)" : "rgba(255,255,255,0.06)"); border-radius: 4px; transition: height 0.3s ease;"></div>
            </div>
        }
    </div>

    <!-- X-Axis Labels -->
    <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted); margin-top: 8px;">
        <span>Day 1</span>
        <span>Day 5</span>
        <span>Day 10</span>
        <span>Day 15</span>
        <span>Day 20</span>
    </div>
</div>
