@{
    ViewData["Title"] = "Sign In - PaisaFlow";
    var returnUrl = ViewBag.ReturnUrl as string ?? "/";
    var error = ViewBag.ErrorMessage as string;
}

<div style="min-height: 80vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 20px 0;">
    <!-- Logo & Brand -->
    <div style="text-align: center; margin-bottom: 28px;">
        <div style="width: 68px; height: 68px; border-radius: 22px; background: linear-gradient(135deg, #0A84FF, #6366F1); display: inline-flex; align-items: center; justify-content: center; font-size: 2.2rem; box-shadow: 0 12px 30px rgba(10, 132, 255, 0.4); margin-bottom: 12px;">
            💰
        </div>
        <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; margin: 0;">PaisaFlow</h1>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 4px 0 0;">Your personal money companion.</p>
    </div>

    <!-- Login Glass Card -->
    <div class="glass-card" style="width: 100%; max-width: 420px; padding: 28px 24px; border-radius: 30px;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 18px; text-align: center;">Welcome Back</h2>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div style="background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(239, 68, 68, 0.35); color: #fca5a5; padding: 10px 14px; border-radius: 14px; font-size: 0.85rem; font-weight: 600; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>@error</span>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="sheet-field" style="margin-bottom: 14px;">
                <i class="bi bi-envelope"></i>
                <input type="email" name="email" class="sheet-input" placeholder="Email address" value="harsh@example.com" required autofocus />
            </div>

            <div class="sheet-field" style="margin-bottom: 20px;">
                <i class="bi bi-lock"></i>
                <input type="password" name="password" class="sheet-input" placeholder="Password" value="Password@123" required />
            </div>

            <button type="submit" class="btn-save-main" style="margin-top: 0;">SIGN IN</button>
        </form>

        <div style="text-align: center; margin-top: 20px; font-size: 0.88rem; color: var(--text-muted);">
            Don't have an account? 
            <a asp-controller="Account" asp-action="Register" style="color: var(--accent-blue); font-weight: 700; text-decoration: none;">Create Account</a>
        </div>

        <!-- 1-Tap Quick Demo Switcher -->
        <div style="margin-top: 24px; padding-top: 18px; border-top: 1px dashed var(--glass-border);">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; text-align: center; margin-bottom: 10px;">
                ⚡ 1-Tap Demo Accounts
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                <form asp-controller="Account" asp-action="QuickSwitch" method="post" style="margin: 0;">
                    <input type="hidden" name="email" value="harsh@example.com" />
                    <button type="submit" class="quick-add-btn" style="width: 100%; justify-content: center; background: var(--glass-bg-subtle); border: 1px solid var(--glass-border); color: var(--text-primary); font-size: 0.8rem; padding: 8px 10px;">
                        👤 Harsh (Demo)
                    </button>
                </form>
                <form asp-controller="Account" asp-action="QuickSwitch" method="post" style="margin: 0;">
                    <input type="hidden" name="email" value="priya@example.com" />
                    <button type="submit" class="quick-add-btn" style="width: 100%; justify-content: center; background: var(--glass-bg-subtle); border: 1px solid var(--glass-border); color: var(--text-primary); font-size: 0.8rem; padding: 8px 10px;">
                        👤 Priya (Demo)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
